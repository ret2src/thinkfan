[Unit]
Description=Notify thinkfan of imminent sleep
Before=sleep.target

[Service]
Type=oneshot
ExecStart=-/usr/bin/systemctl kill --kill-whom=main --signal=SIGPWR thinkfan.service
# Hack: Since the signal handler races with the sleep, we need to delay a bit
ExecStart=sleep 1

[Install]
WantedBy=sleep.target
